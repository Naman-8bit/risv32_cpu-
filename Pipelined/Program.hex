// program.hex
00500093 // 1. addi x1, x0, 5    (x1 = 5)
00A00113 // 2. addi x2, x0, 10   (x2 = 10)
002081B3 // 3. add  x3, x1, x2   (x3 = x1 + x2 = 15) -> Triggers Forwarding
00302223 // 4. sw   x3, 4(x0)    (mem[4] = 15)       
00402203 // 5. lw   x4, 4(x0)    (x4 = mem[4] = 15)
004202B3 // 6. add  x5, x4, x4   (x5 = 15 + 15 = 30) -> Triggers Load-Use Stall
00000063 // 7. beq  x0, x0, 0    (Infinite loop)     -> Triggers Branch Flush